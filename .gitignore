# Секреты и OAuth
.env
*.env.local
auth.json
auth/
oauth/
credentials/*
!credentials/.gitkeep
!credentials/*.example.json
secrets/

# Состояние Hermes
runtime/*
!runtime/.gitkeep
backups/*
!backups/.gitkeep
state.db
state.db-*
memory_store.db
memory_store.db-*

# Личные заметки, которые не должны случайно попасть в git
knowledge/private/*
!knowledge/private/.gitkeep

# Локальные артефакты
*.log
*.tmp
*.bak
*.zip
*.tar.gz
.DS_Store
Thumbs.db
.idea/
.vscode/
.pytest_cache/
__pycache__/
